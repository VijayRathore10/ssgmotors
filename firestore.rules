rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'Rats.Vijay@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'email', 'message']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 200 &&
        data.message is string && data.message.size() <= 5000;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Products / Commercial Vehicles catalog
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    // Testimonials
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    // Site Settings
    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    // Inquiries (Buyer leads)
    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming());
      allow read, update, delete: if isAdmin() || isSignedIn();
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
